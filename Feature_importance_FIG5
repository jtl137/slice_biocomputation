    y_combined = np.concatenate([np.zeros(X_A.shape[0]), np.ones(X_B.shape[0])])
    
    # Generate SHAP array of shape (bins, channels, bands)
    shap_imp = shap_feature_importance(X_combined, y_combined, background_size=100)
